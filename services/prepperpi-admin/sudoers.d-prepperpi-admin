# /etc/sudoers.d/prepperpi-admin
# PrepperPi — let the unprivileged prepperpi-admin user run a small,
# fixed set of privileged workers. Each validates its own JSON-stdin
# payload independently of the FastAPI process that invoked it.
#
# - NOPASSWD because the FastAPI app cannot prompt; it invokes via
#   `sudo -n`.
# - Exact path match. The script is owned root:root mode 0755 so
#   prepperpi-admin cannot tamper with it.
# - No `setenv` / no `*` glob; sudoers' default behavior bars the
#   user from passing -E or substituting binaries.

prepperpi-admin ALL=(root) NOPASSWD: /opt/prepperpi/services/prepperpi-admin/apply-network-config
prepperpi-admin ALL=(root) NOPASSWD: /opt/prepperpi/services/prepperpi-admin/apply-storage-action
prepperpi-admin ALL=(root) NOPASSWD: /opt/prepperpi/services/prepperpi-admin/manage-backup
prepperpi-admin ALL=(root) NOPASSWD: /opt/prepperpi/services/prepperpi-admin/apply-power-action
